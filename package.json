{
  "name": "@corbits/react-ui",
  "version": "0.2.0",
  "description": "React components for agent and workflow surfaces.",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "license": "LGPL-2.1-only",
  "engines": {
    "node": ">=24",
    "bun": ">=1.2.0"
  },
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": [
    "**/*.css"
  ],
  "homepage": "https://github.com/corbitsdev/react-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/react-ui.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/react-ui/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types && bun run build:css && bun run contrast-test && bun run dep-guard",
    "clean": "rm -rf dist",
    "build:js": "swc src -d dist --strip-leading-paths --extensions .ts,.tsx --ignore \"**/*.test.ts\" --ignore \"**/*.test.tsx\"",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css && cp src/theme.css dist/theme.css",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "dep-guard": "node scripts/dep-guard.mjs",
    "contrast-test": "node scripts/contrast-test.mjs",
    "stories": "ladle serve --host 127.0.0.1",
    "stories:build": "ladle build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.545.0 || ^1.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@ladle/react": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.13.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/command-palette": {
      "types": "./dist/ui/command-palette.d.ts",
      "default": "./dist/ui/command-palette.js"
    },
    "./ui/dialog": {
      "types": "./dist/ui/dialog.d.ts",
      "default": "./dist/ui/dialog.js"
    },
    "./ui/menu": {
      "types": "./dist/ui/menu.d.ts",
      "default": "./dist/ui/menu.js"
    },
    "./ui/mic-permission-dialog": {
      "types": "./dist/ui/mic-permission-dialog.d.ts",
      "default": "./dist/ui/mic-permission-dialog.js"
    },
    "./ui/toast": {
      "types": "./dist/ui/toast.d.ts",
      "default": "./dist/ui/toast.js"
    },
    "./ui/tooltip": {
      "types": "./dist/ui/tooltip.d.ts",
      "default": "./dist/ui/tooltip.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  }
}
