{
  "name": "@corbits/react-ui",
  "version": "0.2.0",
  "description": "React components for agent and workflow surfaces.",
  "keywords": [
    "agents",
    "components",
    "corbits",
    "interchange",
    "react",
    "tailwind",
    "ui",
    "workflows"
  ],
  "homepage": "https://github.com/corbitsdev/react-ui#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/react-ui/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/react-ui.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/command-palette": {
      "types": "./dist/ui/command-palette.d.ts",
      "default": "./dist/ui/command-palette.js"
    },
    "./ui/dialog": {
      "types": "./dist/ui/dialog.d.ts",
      "default": "./dist/ui/dialog.js"
    },
    "./ui/menu": {
      "types": "./dist/ui/menu.d.ts",
      "default": "./dist/ui/menu.js"
    },
    "./ui/mic-permission-dialog": {
      "types": "./dist/ui/mic-permission-dialog.d.ts",
      "default": "./dist/ui/mic-permission-dialog.js"
    },
    "./ui/toast": {
      "types": "./dist/ui/toast.d.ts",
      "default": "./dist/ui/toast.js"
    },
    "./ui/tooltip": {
      "types": "./dist/ui/tooltip.d.ts",
      "default": "./dist/ui/tooltip.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run build:css",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "test:e2e": "bun test e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css && cp src/theme.css dist/theme.css",
    "dep-guard": "node scripts/dep-guard.mjs",
    "contrast-test": "node scripts/contrast-test.mjs",
    "stories": "ladle serve --host 127.0.0.1",
    "stories:build": "ladle build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@ladle/react": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "lucide-react": "^1.27.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.545.0 || ^1.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
